# Ortam değişkenlerinin yalnız adları. Değerleri asla commit etme (AGENTS.md §5).
# Sırlar yalnız Vercel sunucu ortam değişkeninde durur; NEXT_PUBLIC_ önekli sır yok.

# AI ile onar (spec §4.5 E12)
VERTEX_API_KEY=
# AI PIN'i: tam 4 rakam (değilse AI "ayarlanmamış" der). Değişince eşli tüm cihazlar yeniden PIN ister.
CURATE_AI_PASSWORD=
# true/false; false ile tüm AI kapanır (varsayılan açık)
AI_ENABLED=
# Çağrı sayısı sınırı (ikincil güvenlik). Varsayılan 80 / 1000
AI_DAILY_LIMIT=
AI_MONTHLY_LIMIT=

# AI para bütçesi (₺, D35). Eksik ya da bozuksa kod varsayılanları geçerli, sınırsıza düşmez.
# Varsayılanlar: toplam 6000, günlük 300, pencere sonu 2026-12-17, pencere sonrası aylık 200
AI_BUDGET_TRY_TOTAL=
AI_BUDGET_TRY_DAILY=
AI_BUDGET_WINDOW_END=
AI_BUDGET_TRY_MONTHLY_AFTER=

# Kota sayacı: Upstash Redis REST. İki ad takımından biri yeterli (Vercel Marketplace KV_* adlarını verir).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
