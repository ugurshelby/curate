# Varsayılan 20 / 150
AI_DAILY_LIMIT=
AI_MONTHLY_LIMIT=

# Kota sayacı: Upstash Redis REST. İki ad takımından biri yeterli (Vercel Marketplace KV_* adlarını verir).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
