{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Curate Design System Tokens (kopya; kaynak app/globals.css ve tailwind.config.ts)",
  "version": "3.0.0",
  "surface": {
    "base": {
      "value": "#000000",
      "type": "color",
      "description": "Zemin (OLED siyah)"
    },
    "surface1": {
      "value": "#1C1C1E",
      "type": "color",
      "description": "Yüzey 1: kart, panel, sheet"
    },
    "surface2": {
      "value": "#2C2C2E",
      "type": "color",
      "description": "Yüzey 2: çip, giriş, ikincil düğme (basılı: ayırıcı tonu)"
    },
    "separator": {
      "value": "#38383A",
      "type": "color",
      "description": "Ayırıcı: tek ince çizgi"
    }
  },
  "accent": {
    "accent": {
      "value": "#0A84FF",
      "type": "color",
      "description": "Vurgu: çizgi, kaydırıcı dolgusu, ikon, odak halkası (2 px), koyu zeminde yazı"
    },
    "accentFill": {
      "value": "#0071E3",
      "type": "color",
      "description": "Vurgu dolgu zemini (beyaz yazı 4,7:1; #0A84FF ile 3,65:1). Sahip onayı 2026-10-03"
    },
    "onAccent": {
      "value": "#FFFFFF",
      "type": "color",
      "description": "Vurgu üstü yazı"
    },
    "danger": {
      "value": "#FF453A",
      "type": "color",
      "description": "Hata ve silme"
    },
    "success": {
      "value": "#30D158",
      "type": "color",
      "description": "Başarı"
    }
  },
  "text": {
    "ink1": {
      "value": "#FFFFFF",
      "type": "color",
      "description": "Yazı 1"
    },
    "ink2": {
      "value": "#AEAEB2",
      "type": "color",
      "description": "Yazı 2"
    },
    "ink3": {
      "value": "#8E8E93",
      "type": "color",
      "description": "Yazı 3 (yüzey 2 üstünde 4,27:1: yalnız zemin ve yüzey 1 üstünde kullan)"
    },
    "disabledSurface": {
      "value": "#2C2C2E",
      "type": "color",
      "description": "Devre dışı yüzey"
    },
    "disabledInk": {
      "value": "#636366",
      "type": "color",
      "description": "Devre dışı yazı"
    }
  },
  "radius": {
    "sm": {
      "value": "8px",
      "type": "dimension",
      "description": "Inner buttons, badges, micro pills"
    },
    "md": {
      "value": "12px",
      "type": "dimension",
      "description": "Standard interactive elements, input fields"
    },
    "lg": {
      "value": "18px",
      "type": "dimension",
      "description": "Cards, dialog boxes, floating toolbars"
    },
    "sheet": {
      "value": "28px",
      "type": "dimension",
      "description": "Bottom sheets, modal cards, studio workspace frames"
    },
    "full": {
      "value": "9999px",
      "type": "dimension",
      "description": "Pill buttons, floating status indicators"
    }
  },
  "motion": {
    "timing": {
      "springSmooth": {
        "value": "cubic-bezier(0.32, 0.72, 0, 1)",
        "type": "cubicBezier",
        "description": "Native iOS sheet & panel physics"
      },
      "springSnappy": {
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "type": "cubicBezier",
        "description": "Button presses, quick toggles, feedback pulses"
      }
    },
    "duration": {
      "fast": {
        "value": "150ms",
        "type": "duration",
        "description": "Hover, micro-feedback, state toggle"
      },
      "normal": {
        "value": "250ms",
        "type": "duration",
        "description": "Dropdowns, expand/collapse, tab switches"
      },
      "sheet": {
        "value": "380ms",
        "type": "duration",
        "description": "Bottom sheet entrance, modal reveals"
      }
    },
    "easeSpring": {
      "value": "cubic-bezier(0.32, 0.72, 0, 1)",
      "type": "cubicBezier",
      "description": "Basma ve küçük geri bildirim"
    },
    "pressScale": {
      "value": 0.98,
      "type": "number",
      "description": "Basma; küçük düğmede 0.96"
    },
    "pressDuration": {
      "value": "160ms",
      "type": "duration"
    }
  },
  "glass": {
    "fill": {
      "value": "rgba(28, 28, 30, 0.72)",
      "type": "color",
      "description": "Liquid glass background fill (yüzey 1, %72)"
    },
    "border": {
      "value": "#38383A",
      "type": "color",
      "description": "1px hairline glass border (ayırıcı)"
    },
    "blur": {
      "value": "20px",
      "type": "dimension",
      "description": "GPU-friendly backdrop-blur-xl"
    },
    "rimLight": {
      "value": "inset 0 1px 0 rgba(255, 255, 255, 0.12)",
      "type": "boxShadow",
      "description": "Top rim light reflecting edge"
    },
    "shadow": {
      "value": "0 8px 32px rgba(0, 0, 0, 0.5)",
      "type": "boxShadow",
      "description": "Depth elevation shadow"
    }
  },
  "typography": {
    "fontFamily": {
      "value": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", Inter (next/font, self-host), system-ui, sans-serif",
      "type": "fontFamily"
    },
    "display": {
      "value": {
        "fontSize": "28px",
        "fontWeight": 600,
        "letterSpacing": "-0.02em",
        "lineHeight": 1.15
      },
      "type": "typography"
    },
    "title": {
      "value": {
        "fontSize": "20px",
        "fontWeight": 600,
        "letterSpacing": "-0.02em",
        "lineHeight": 1.2
      },
      "type": "typography"
    },
    "headline": {
      "value": {
        "fontSize": "17px",
        "fontWeight": 600,
        "letterSpacing": "-0.01em",
        "lineHeight": 1.3
      },
      "type": "typography"
    },
    "body": {
      "value": {
        "fontSize": "15px",
        "fontWeight": 400,
        "letterSpacing": "-0.005em",
        "lineHeight": 1.45
      },
      "type": "typography"
    },
    "subhead": {
      "value": {
        "fontSize": "14px",
        "fontWeight": 500,
        "letterSpacing": "0",
        "lineHeight": 1.4
      },
      "type": "typography"
    },
    "footnote": {
      "value": {
        "fontSize": "13px",
        "fontWeight": 400,
        "letterSpacing": "0",
        "lineHeight": 1.4
      },
      "type": "typography"
    },
    "caption": {
      "value": {
        "fontSize": "12px",
        "fontWeight": 500,
        "letterSpacing": "0.01em",
        "lineHeight": 1.35
      },
      "type": "typography",
      "description": "En küçük yazı (12px)"
    }
  },
  "material": {
    "card": {
      "value": "surface1 + linear-gradient(white 6% → 2% → 0) + 1px separator + inset 0 1px 0 white 12%",
      "type": "other",
      "description": ".material-card (opak, cam sayılmaz)"
    },
    "chip": {
      "value": "white 8% fill + white 10% border, pill",
      "type": "other",
      "description": ".material-chip"
    },
    "glass": {
      "value": "surface1 72% + blur(20px) + separator border + inset 0 1px 0 white 12%",
      "type": "other",
      "description": ".glass-panel, ekranda en çok 3"
    }
  }
}
